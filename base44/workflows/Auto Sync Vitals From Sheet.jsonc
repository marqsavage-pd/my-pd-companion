{
  "name": "Auto Sync Vitals From Sheet",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Automatically syncs vital signs, dwell/lost-dwell, and lab results from the patient's Google Sheet into the app every 15 minutes.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sync_vitals",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_vitals": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncVitalsFromSheet",
            "args": {
              "start_date": "2026-01-01",
              "only_nulls": false
            }
          },
          "then": "sync_dwell",
          "x-base44": {
            "title": "Sync vitals (weight & BP)",
            "description": "From Google Sheet"
          }
        }
      },
      {
        "sync_dwell": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncDwellFromSheet",
            "args": {
              "start_date": "2026-01-01",
              "only_nulls": false
            }
          },
          "then": "sync_labs",
          "x-base44": {
            "title": "Sync dwell & lost dwell",
            "description": "Treatment metrics into exchanges"
          }
        }
      },
      {
        "sync_labs": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncLabResultsFromSheet",
            "args": {
              "start_date": "2026-01-01",
              "only_nulls": false
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync lab results",
            "description": "From Labs tab"
          }
        }
      }
    ]
  }
}