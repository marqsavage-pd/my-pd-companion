{
  "name": "SharedReport",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Unique share token for the secure link"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the shared link expires"
    },
    "window_days": {
      "type": "number",
      "default": 30,
      "description": "Report data window in days (7, 14, or 30)"
    }
  },
  "required": [
    "token",
    "expires_at"
  ],
  "rls": {
    "create": null,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}