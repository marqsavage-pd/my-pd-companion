{
  "name": "Exchange",
  "type": "object",
  "properties": {
    "modality": {
      "type": "string",
      "enum": [
        "capd",
        "apd"
      ]
    },
    "dextrose_concentration": {
      "type": "number",
      "description": "Effective dextrose concentration (%) \u2014 single value or average of a blend"
    },
    "dextrose_blend": {
      "type": "string",
      "description": "Components of a mixed dialysate, e.g. '1.5+2.5'",
      "pattern": "^\\d+(\\.\\d+)?\\+\\d+(\\.\\d+)?$"
    },
    "fill_volume": {
      "type": "number",
      "description": "Volume infused in mL"
    },
    "drain_volume": {
      "type": "number",
      "description": "Volume drained in mL"
    },
    "ultrafiltration": {
      "type": "number",
      "description": "Net fluid removed in mL (drain - fill)"
    },
    "dwell_hours": {
      "type": "number"
    },
    "lost_dwell": {
      "type": "number",
      "description": "Lost dwell volume in mL"
    },
    "solution_appearance": {
      "type": "string",
      "enum": [
        "clear",
        "cloudy",
        "bloody",
        "fibrin"
      ]
    },
    "notes": {
      "type": "string"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "weight": {
      "type": "number",
      "description": "Pre-treatment weight in lbs"
    },
    "bp_systolic": {
      "type": "number",
      "description": "Pre-treatment systolic blood pressure (mmHg)"
    },
    "bp_diastolic": {
      "type": "number",
      "description": "Pre-treatment diastolic blood pressure (mmHg)"
    }
  },
  "required": [
    "modality",
    "dextrose_concentration",
    "fill_volume",
    "drain_volume",
    "solution_appearance",
    "logged_at"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}